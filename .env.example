# Copier en .env à la racine (jamais commité). Les mêmes valeurs vont dans Vercel > Settings > Environment Variables.

# Site (build) : lecture du contenu publié
SANITY_PROJECT_ID=
SANITY_DATASET=production
SITE_URL=https://seuil.vercel.app

# npm run seed : jeton « Editor » (sanity.io/manage > API > Tokens)
SANITY_WRITE_TOKEN=

# npm run webhook : jeton personnel (npx sanity debug --secrets) et Deploy Hook Vercel
SANITY_AUTH_TOKEN=
VERCEL_DEPLOY_HOOK=
