{
  "name": "seuil",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Site de démonstration de Seuil, entreprise fictive. Astro + Sanity.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "webhook": "node --env-file-if-exists=.env scripts/creer-webhook.ts",
    "studio": "npm --prefix studio run dev",
    "migration:lot1": "node --env-file-if-exists=.env scripts/migrations/2026-11-20-tarifs-et-faits.ts",
    "captures:hd": "node --env-file-if-exists=.env scripts/remplacer-captures.ts"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/urbanist": "^5.3.0",
    "@sanity/client": "^8.16.0",
    "@sanity/image-url": "^2.2.0",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
