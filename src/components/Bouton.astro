---
import Icone from './Icone.astro';
import { typo } from '../lib/typo';
import type { Lien } from '../lib/types';

interface Props {
  lien: Lien;
  variante?: 'principal' | 'secondaire';
  /** Pleine largeur sur mobile (règle du bouton principal). */
  pleineLargeurMobile?: boolean;
  pleineLargeur?: boolean;
  class?: string;
}
const { lien, variante = 'principal', pleineLargeurMobile = variante === 'principal', pleineLargeur = false, class: classe } = Astro.props;
---

<a
  href={lien.href}
  class:list={['bouton', `bouton--${variante}`, { 'bouton--mobile-plein': pleineLargeurMobile, 'bouton--plein': pleineLargeur }, classe]}
>
  {typo(lien.libelle)}
  {variante === 'principal' && <Icone nom="fleche" />}
</a>

<style is:global>
  .bouton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-100);
    height: 48px;
    padding: 0 var(--space-300);
    border: 0;
    border-radius: var(--radius-full);
    font-family: var(--text-md-family);
    font-size: var(--text-md-size);
    line-height: var(--text-md-line);
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .bouton--principal {
    background: var(--color-accent-default);
    color: var(--color-text-on-accent);
    font-weight: 600;
  }

  .bouton--principal:hover {
    background: var(--color-accent-hover);
  }

  .bouton--principal:disabled,
  .bouton--principal[aria-disabled='true'] {
    background: var(--color-disabled-bg);
    color: var(--color-disabled-text);
    cursor: not-allowed;
  }

  /* Secondaire à contour. Survol à dériver : --color-bg-subtle. */
  .bouton--secondaire {
    background: transparent;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .bouton--secondaire:hover {
    background: var(--color-bg-subtle);
  }

  .bouton--plein {
    width: 100%;
  }

  @media (max-width: 767px) {
    .bouton--mobile-plein {
      width: 100%;
    }
  }
</style>
