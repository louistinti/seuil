---
// Capture produit. Écran d'ordinateur en pleine largeur, ou téléphone si l'image est en portrait.
// Sur mobile, `mobile` la remplace : recadrage d'un panneau (crop Sanity) ou vue téléphone.
import { src, srcset, stylesRecadrage, zoneRecadree } from '../lib/images';
import type { Image } from '../lib/types';

interface Props {
  image: Image;
  mobile?: Image | null;
  /** Largeur maximale d'affichage, pour le choix des tailles d'image. */
  largeur?: number;
  chargement?: 'lazy' | 'eager';
}
const { image, mobile, largeur = 1296, chargement = 'lazy' } = Astro.props;
const telephone = (i: Image) => i.hauteur > i.largeur;

// Largeur réellement affichée, selon les marges du conteneur (16, 32 puis 64 px) et le plafond de 1296 px.
const TAILLES_ECRAN = `(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc(100vw - 64px), (max-width: ${largeur + 127}px) calc(100vw - 128px), ${largeur}px`;
const TAILLES_TELEPHONE = '(max-width: 767px) calc(100vw - 32px), (max-width: 1023px) 300px, 320px';
// Variante mobile, affichée sous 768 px seulement, sur toute la largeur du conteneur.
const TAILLES_MOBILE = 'calc(100vw - 32px)';

// Recadrage : avec Sanity, le CDN ne renvoie que la zone recadrée (paramètre rect), affichée telle quelle.
// En local, sans CDN, l'image entière est agrandie et décalée en CSS.
const zone = mobile ? zoneRecadree(mobile) : null;
const recadrageCdn = Boolean(mobile?.sanity && zone);
const recadrageCss = Boolean(mobile?.crop && !recadrageCdn);
---

<figure class:list={['capture', { 'capture--avec-mobile': mobile }]} data-theme="produit">
  <div class:list={['cadre', { 'cadre--telephone': telephone(image) }]}>
    <img
      src={src(image, telephone(image) ? 780 : 1440)}
      srcset={srcset(image)}
      sizes={telephone(image) ? TAILLES_TELEPHONE : TAILLES_ECRAN}
      width={image.largeur}
      height={image.hauteur}
      alt={image.alt}
      loading={chargement}
      decoding="async"
    />
  </div>
  {
    mobile && (
      <div class:list={['cadre', 'cadre--mobile', { 'cadre--telephone': telephone(mobile) && !mobile.crop }]} style={recadrageCss ? stylesRecadrage(mobile) : undefined}>
        <img
          class:list={{ recadre: recadrageCss }}
          src={src(mobile, 1080, recadrageCdn)}
          srcset={srcset(mobile, recadrageCdn)}
          sizes={TAILLES_MOBILE}
          width={recadrageCdn ? zone!.largeur : mobile.largeur}
          height={recadrageCdn ? zone!.hauteur : mobile.hauteur}
          alt={mobile.alt}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
</figure>

<style>
  .capture {
    margin: 0;
    background: transparent;
  }

  .cadre {
    width: 100%;
    max-width: 1296px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: var(--radius-2xl);
    background: var(--color-bg-page);
    box-shadow: var(--shadow-lg);
  }

  .cadre img {
    width: 100%;
  }

  .cadre--telephone {
    max-width: 320px;
  }

  .cadre--mobile {
    display: none;
  }

  /* Recadrage : la fenêtre a les proportions du crop, l'image est agrandie et décalée. */
  .cadre--mobile[style] {
    position: relative;
    aspect-ratio: var(--ratio);
  }

  .cadre .recadre {
    position: absolute;
    left: var(--decalage-x);
    top: var(--decalage-y);
    width: var(--echelle);
    max-width: none;
  }

  @media (max-width: 767px) {
    .cadre--telephone {
      max-width: 100%;
    }

    .capture--avec-mobile .cadre:not(.cadre--mobile) {
      display: none;
    }

    .capture--avec-mobile .cadre--mobile {
      display: block;
    }
  }
</style>
