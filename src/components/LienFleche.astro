---
import Icone from './Icone.astro';
import { typo } from '../lib/typo';
import type { Lien } from '../lib/types';

interface Props {
  lien: Lien;
}
const { lien } = Astro.props;
---

<a class="lien-fleche" href={lien.href}>{typo(lien.libelle)}<Icone nom="fleche" /></a>

<style>
  .lien-fleche {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-100);
    min-height: var(--target-min);
    color: var(--color-accent-text);
    font-size: var(--text-md-size);
    line-height: var(--text-md-line);
    font-weight: 600;
    text-decoration: none;
  }

  /* Survol à dériver : soulignement. */
  .lien-fleche:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
