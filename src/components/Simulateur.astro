---
// Simulateur de décision : seul composant interactif côté client, en TypeScript sans framework.
// Rendu initial côté serveur (Menuiseries Valdorre, 38 000 €), puis mis à jour par le script.
import Etiquette from './Etiquette.astro';
import Icone from './Icone.astro';
import {
  affichageUsage,
  clientParId,
  clients,
  decider,
  euros,
  montantParDefaut,
  montantsChips,
  messageErreurSaisie,
} from '../lib/simulateur';
import { VERDICTS, conditionEnCause, faits, largeurJauge, nomRegle } from '../lib/simulateur-affichage';

const client = clients[0];
const d = decider(clientParId(client.id), montantParDefaut);
const etat = d.resultat === 'Acceptée' ? 'accepted' : d.resultat === 'Refusée' ? 'refused' : 'pending';
const f = faits(client);
const ligneUsage = affichageUsage(d);
---

<div class="sim-cadre">
  <section id="simulateur" class="simulateur" data-theme="produit" aria-labelledby="sim-titre">
    <div class="sim-entete">
      <h2 id="sim-titre" class="sim-titre">Simulateur de décision</h2>
      <Etiquette>Données fictives</Etiquette>
    </div>

    <div class="groupe">
      <span id="sim-clients" class="libelle-groupe">Client</span>
      <div class="chips" role="group" aria-labelledby="sim-clients">
        {
          clients.map((c, i) => (
            <button type="button" class="chip" data-client={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              {c.nom}
            </button>
          ))
        }
      </div>
      <dl class="faits chiffres" aria-label="Faits du client">
        {
          f.map((fait) => (
            <div class="fait">
              <dt>{fait.libelle}</dt>
              <dd data-fait={fait.cle}>{fait.valeur}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="groupe">
      <span id="sim-montants" class="libelle-groupe">Montant de la commande</span>
      <div class="chips" role="group" aria-labelledby="sim-montants">
        {
          montantsChips.map((m) => (
            <button type="button" class="chip chiffres" data-montant={m} aria-pressed={m === montantParDefaut ? 'true' : 'false'}>
              {euros(m)}
            </button>
          ))
        }
      </div>
      <div class="champ">
        <label for="sim-autre">Autre montant</label>
        <input id="sim-autre" class="chiffres" type="text" inputmode="numeric" autocomplete="off" placeholder="Par exemple 68 000" aria-describedby="sim-erreur" />
        <span id="sim-erreur" class="erreur" role="alert" hidden>
          <Icone nom="alerte" taille={14} />
          <span>{messageErreurSaisie}</span>
        </span>
      </div>
    </div>

    <div class="resultat" aria-live="polite" aria-atomic="true">
      <!-- État neutre (non dessiné, dérivé) : remplace la décision tant que la saisie est invalide. -->
      <p class="resultat-neutre" data-sim="neutre" hidden>Saisissez un montant pour voir la décision.</p>
      <div class="decision" data-sim="decision">
      <div class="verdict">
        <span class="badge" data-etat={etat} data-sim="badge">
          <span class="icone-etat icone-accepted"><Icone nom="coche" taille={14} /></span>
          <span class="icone-etat icone-refused"><Icone nom="croix" taille={14} /></span>
          <span class="icone-etat icone-pending"><Icone nom="horloge" taille={14} /></span>
          <span data-sim="resultat">{d.resultat}</span>
        </span>
        <p class="phrase" data-sim="verdict">{VERDICTS[d.resultat]}</p>
        <span class="priorite" data-sim="priorite" hidden={d.priorite !== 'haute'}>
          <Etiquette>Priorité haute</Etiquette>
        </span>
      </div>

      <div class="usage">
        <div class="ligne-total">
          <span class="texte-secondaire">Encours après commande</span>
          <span class="chiffres total" data-sim="total">{euros(d.total)}</span>
        </div>
        <div class="jauge" aria-hidden="true">
          <div class="jauge-remplissage" data-sim="jauge" style={`width: ${largeurJauge(d)}%`}></div>
        </div>
        <p class="chiffres ligne-usage" data-sim="usage" data-depasse={d.depassement > 0 ? 'true' : 'false'}>
          {d.depassement > 0 ? ligneUsage : `${ligneUsage} de la limite`}
        </p>
      </div>

      <div class="bloc-regle">
        <span class="regle-nom" data-sim="regle">{nomRegle(d)}</span>
        <div class="regle-corps">
          <span data-sim="libelle">{d.libelle}</span>
          <ul class="conditions" data-sim="conditions" hidden={d.conditionsEchouees.length === 0}>
            {d.conditionsEchouees.map((c) => <li>{conditionEnCause(c)}</li>)}
          </ul>
        </div>
      </div>
      </div>
    </div>
  </section>
</div>

<script>
  import { affichageUsage, clientParId, decider, euros, lireMontant, type Decision } from '../lib/simulateur';
  import { VERDICTS, conditionEnCause, faits, largeurJauge, nomRegle } from '../lib/simulateur-affichage';

  const racine = document.getElementById('simulateur');
  if (racine) {
    // Hero en deux colonnes : la colonne de texte est centrée sur la hauteur initiale de la carte, mesurée une fois.
    // Quand la décision change, la carte grandit ou rétrécit vers le bas sans faire bouger le titre.
    const grille = racine.closest<HTMLElement>('.grille-hero');
    if (grille) {
      // Après le chargement des polices : avant, la hauteur mesurée serait fausse. D'ici là, le centrage CSS s'applique.
      document.fonts.ready.then(() => {
        grille.style.setProperty('--hauteur-simulateur', `${racine.offsetHeight}px`);
        grille.dataset.ancre = '';
      });
    }

    const $ = <T extends HTMLElement>(sel: string) => racine.querySelector<T>(sel)!;
    const chipsClients = [...racine.querySelectorAll<HTMLButtonElement>('[data-client]')];
    const chipsMontants = [...racine.querySelectorAll<HTMLButtonElement>('[data-montant]')];
    const champ = $<HTMLInputElement>('#sim-autre');
    const erreur = $('#sim-erreur');

    let clientId = chipsClients.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.client ?? chipsClients[0].dataset.client!;
    // null : la saisie « Autre montant » est invalide, aucune décision n'est affichée.
    let montantValide: number | null = Number(chipsMontants.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.montant ?? chipsMontants[0].dataset.montant);

    const presser = (boutons: HTMLButtonElement[], actif?: HTMLButtonElement) =>
      boutons.forEach((b) => b.setAttribute('aria-pressed', String(b === actif)));

    const afficher = (d: Decision) => {
      const etat = d.resultat === 'Acceptée' ? 'accepted' : d.resultat === 'Refusée' ? 'refused' : 'pending';
      $('[data-sim="badge"]').dataset.etat = etat;
      $('[data-sim="resultat"]').textContent = d.resultat;
      $('[data-sim="verdict"]').textContent = VERDICTS[d.resultat];
      $('[data-sim="priorite"]').hidden = d.priorite !== 'haute';
      $('[data-sim="total"]').textContent = euros(d.total);
      $('[data-sim="jauge"]').style.width = `${largeurJauge(d)}%`;
      const usage = $('[data-sim="usage"]');
      usage.textContent = d.depassement > 0 ? affichageUsage(d) : `${affichageUsage(d)} de la limite`;
      usage.dataset.depasse = String(d.depassement > 0);
      $('[data-sim="regle"]').textContent = nomRegle(d);
      $('[data-sim="libelle"]').textContent = d.libelle;
      const liste = $('[data-sim="conditions"]');
      liste.replaceChildren(
        ...d.conditionsEchouees.map((c) => {
          const li = document.createElement('li');
          li.textContent = conditionEnCause(c);
          return li;
        }),
      );
      liste.hidden = d.conditionsEchouees.length === 0;
    };

    const afficherFaits = () => {
      for (const fait of faits(clientParId(clientId))) {
        $(`[data-fait="${fait.cle}"]`).textContent = fait.valeur;
      }
    };

    const recalculer = () => {
      const masquer = montantValide === null;
      $('[data-sim="decision"]').toggleAttribute('data-masque', masquer);
      $('[data-sim="neutre"]').hidden = !masquer;
      if (montantValide !== null) afficher(decider(clientParId(clientId), montantValide));
    };

    const signalerErreur = (enErreur: boolean) => {
      erreur.hidden = !enErreur;
      if (enErreur) champ.setAttribute('aria-invalid', 'true');
      else champ.removeAttribute('aria-invalid');
    };

    chipsClients.forEach((b) =>
      b.addEventListener('click', () => {
        clientId = b.dataset.client!;
        presser(chipsClients, b);
        afficherFaits();
        recalculer();
      }),
    );

    chipsMontants.forEach((b) =>
      b.addEventListener('click', () => {
        montantValide = Number(b.dataset.montant);
        presser(chipsMontants, b);
        champ.value = '';
        signalerErreur(false);
        recalculer();
      }),
    );

    champ.addEventListener('input', () => {
      if (champ.value.trim() === '') {
        // Champ vidé : plus d'erreur, mais la décision ne revient qu'avec un montant valide ou une chip.
        signalerErreur(false);
        return;
      }
      const lu = lireMontant(champ.value);
      if (lu === null) {
        signalerErreur(true);
        montantValide = null;
        presser(chipsMontants);
        recalculer();
        return;
      }
      signalerErreur(false);
      montantValide = lu;
      presser(chipsMontants, chipsMontants.find((b) => Number(b.dataset.montant) === lu));
      recalculer();
    });
  }
</script>

<style>
  .sim-cadre {
    position: relative;
    width: 100%;
  }

  .simulateur {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-250);
    padding: var(--space-350);
    border-radius: var(--radius-2xl);
    background: color-mix(in srgb, var(--neutral-900) 92%, transparent);
    border: 1px solid var(--color-border-glass);
    backdrop-filter: blur(var(--blur-glass));
    -webkit-backdrop-filter: blur(var(--blur-glass));
    box-shadow: var(--shadow-lg);
    color: var(--color-text-primary);
    font-family: var(--font-text);
  }

  .sim-entete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-150);
  }

  .sim-titre {
    font-family: var(--font-text);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-line);
    font-weight: 600;
  }

  .groupe {
    display: flex;
    flex-direction: column;
    gap: var(--space-100);
  }

  .libelle-groupe {
    font-size: var(--text-xs-size);
    line-height: var(--text-xs-line);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-100);
  }

  /* Chip de choix : verre au repos, sélectionné en plein. Survol à dériver : --color-bg-subtle. */
  .chip {
    display: inline-flex;
    align-items: center;
    height: var(--target-min);
    padding: 0 var(--space-200);
    border-radius: var(--radius-full);
    background: var(--color-bg-glass);
    border: 1px solid var(--color-border-glass);
    color: var(--color-text-primary);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-line);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
  }

  .chip:hover {
    background: var(--color-bg-subtle);
  }

  .chip[aria-pressed='true'] {
    background: var(--color-text-primary);
    border-color: var(--color-text-primary);
    color: var(--color-bg-page);
  }

  .faits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-050) var(--space-300);
    margin: 0;
    padding-top: var(--space-050);
  }

  .fait {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-100);
  }

  .fait dt {
    font-size: var(--text-xs-size);
    line-height: var(--text-xs-line);
    color: var(--color-text-secondary);
  }

  .fait dd {
    margin: 0;
    font-size: var(--figure-sm-size);
    line-height: var(--figure-sm-line);
    font-weight: var(--figure-sm-weight);
    white-space: nowrap;
  }

  .champ {
    display: flex;
    flex-direction: column;
    gap: var(--space-100);
    padding-top: var(--space-100);
  }

  .champ label {
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-line);
    font-weight: 500;
  }

  .champ input {
    width: 100%;
    height: 48px;
    padding: 0 var(--space-200);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-subtle);
    font-size: var(--text-md-size);
    line-height: var(--text-md-line);
  }

  .champ input::placeholder {
    color: var(--color-text-secondary);
    opacity: 1;
  }

  /* Survol à dériver : bordure --color-text-primary. */
  .champ input:hover {
    border-color: var(--color-text-primary);
  }

  .champ input[aria-invalid='true'] {
    border: 2px solid var(--color-state-refused-text);
  }

  .erreur {
    display: inline-flex;
    align-items: center;
    gap: var(--space-050);
    font-size: var(--text-xs-size);
    line-height: var(--text-xs-line);
    color: var(--color-state-refused-text);
  }

  .erreur[hidden] {
    display: none;
  }

  .resultat {
    position: relative;
    padding-top: var(--space-200);
    border-top: 1px solid var(--color-border-glass);
  }

  .decision {
    display: flex;
    flex-direction: column;
    gap: var(--space-200);
  }

  /* La décision garde sa place (pas de saut de mise en page) mais n'est ni vue ni lue. */
  .decision[data-masque] {
    visibility: hidden;
  }

  .resultat-neutre {
    position: absolute;
    inset: var(--space-200) 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-300);
    border-radius: var(--radius-xl);
    border: 1px dashed var(--color-border-glass);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-line);
    color: var(--color-text-secondary);
    text-align: center;
  }

  .resultat-neutre[hidden] {
    display: none;
  }

  .verdict {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-100);
  }

  .icone-etat {
    display: none;
  }

  .badge[data-etat='accepted'] .icone-accepted,
  .badge[data-etat='refused'] .icone-refused,
  .badge[data-etat='pending'] .icone-pending {
    display: inline-flex;
  }

  .phrase {
    font-family: var(--title-md-family);
    font-size: var(--title-md-size);
    line-height: var(--title-md-line);
    font-weight: var(--title-md-weight);
  }

  .priorite[hidden] {
    display: none;
  }

  .usage {
    display: flex;
    flex-direction: column;
    gap: var(--space-100);
  }

  .ligne-total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-150);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-line);
  }

  .total {
    font-size: var(--text-md-size);
    line-height: var(--text-md-line);
    font-weight: 500;
  }

  .jauge {
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-border-default);
    overflow: hidden;
  }

  .jauge-remplissage {
    height: 100%;
    border-radius: var(--radius-full);
    background: var(--color-gauge-fill);
    transition: width 0.25s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .jauge-remplissage {
      transition: none;
    }
  }

  .ligne-usage {
    font-size: var(--text-xs-size);
    line-height: var(--text-xs-line);
    color: var(--color-text-secondary);
  }

  .ligne-usage[data-depasse='true'] {
    font-size: var(--figure-sm-size);
    line-height: var(--figure-sm-line);
    font-weight: var(--figure-sm-weight);
    color: var(--color-text-primary);
  }

  /* Bloc règle : contour pointillé, numéro en accent. */
  .bloc-regle {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-050) var(--space-150);
    padding: var(--space-150) var(--space-200);
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-border-strong);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-line);
    color: var(--color-text-secondary);
  }

  .regle-nom {
    color: var(--color-accent-text);
    font-weight: 600;
    white-space: nowrap;
  }

  .regle-corps {
    flex: 1 1 200px;
    display: flex;
    flex-direction: column;
    gap: var(--space-100);
  }

  .conditions {
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-050);
    color: var(--color-text-primary);
    font-variant-numeric: var(--figure-numeric);
  }

  .conditions[hidden] {
    display: none;
  }

  @media (max-width: 767px) {
    .simulateur {
      padding: var(--space-250);
    }

    .faits {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
