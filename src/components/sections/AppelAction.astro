---
import Bouton from '../Bouton.astro';
import Emplacement from '../Emplacement.astro';
import Entete from '../Entete.astro';
import FormulaireDemo from '../FormulaireDemo.astro';
import Precision from '../Precision.astro';
import { typo } from '../../lib/typo';
import type { SectionAppelAction } from '../../lib/types';

interface Props {
  section: SectionAppelAction;
  niveau: 1 | 2;
}
const { section: s, niveau } = Astro.props;
const Titre = niveau === 1 ? 'h1' : 'h2';
---

{
  s.variante === 'bandeau' ? (
    <section class="conteneur" id={s.ancre}>
      <div class="bandeau" data-theme="produit">
        <Titre class="titre-section titre-bandeau">{typo(s.titre)}</Titre>
        {s.texte && <p class="chapeau">{typo(s.texte)}</p>}
        {s.bouton && <Bouton lien={s.bouton} />}
      </div>
    </section>
  ) : (
    <section class="conteneur formulaire-section" id={s.ancre}>
      <div class="colonne-texte">
        <Entete surtitre={s.surtitre} titre={s.titre} texte={s.texte} niveau={niveau} sansMarge class:list={{ 'entete-h1': niveau === 1 }} />
        {s.delaiReponse ? <Precision texte={s.delaiReponse} icone="horloge" /> : s.delai && <Emplacement libelle={s.delai.libelle} taille="prix" />}
      </div>
      <FormulaireDemo roles={s.roles ?? []} libelleEnvoi={s.libelleEnvoi ?? 'Demander une démo'} mention={s.mention ?? "Formulaire de démonstration : rien n'est envoyé."} />
    </section>
  )
}

<style>
  /* Bandeau d'appel à l'action : fond --neutral-900, thème produit pour le contenu. */
  .bandeau {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-300);
    padding: var(--space-800);
    border-radius: var(--radius-2xl);
    background: var(--neutral-900);
    color: var(--color-text-primary);
  }

  .titre-bandeau {
    max-width: 800px;
  }

  .bandeau .chapeau {
    max-width: 560px;
  }

  .formulaire-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 480px;
    gap: var(--space-1200);
    align-items: start;
    padding-top: var(--space-800);
  }

  .colonne-texte {
    display: flex;
    flex-direction: column;
    gap: var(--space-300);
  }

  .colonne-texte :global(.entete-h1 .titre-section) {
    font-family: var(--display-md-family);
    font-size: var(--display-md-size);
    line-height: var(--display-md-line);
    letter-spacing: var(--display-md-tracking);
  }

  @media (max-width: 1023px) {
    .formulaire-section {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-500);
    }
  }

  /* Même écart surtitre, titre, chapeau que le hero des autres pages : le titre ne saute pas d'une page à l'autre. */
  .colonne-texte :global(.entete-h1) {
    gap: var(--space-300);
  }

  @media (max-width: 767px) {
    .colonne-texte :global(.entete-h1) {
      gap: var(--space-250);
    }

    .bandeau {
      padding: var(--space-400) var(--space-300);
    }

    .formulaire-section {
      padding-top: var(--space-500);
    }

    .colonne-texte :global(.entete-h1 .titre-section) {
      font-size: var(--title-lg-size);
      line-height: var(--title-lg-line);
    }
  }
</style>
