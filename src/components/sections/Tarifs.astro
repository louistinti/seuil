---
// Cartes de formule. Elles se distinguent d'abord par la tranche de chiffre d'affaires.
// Prix et seuils remplis : la ligne de source sous les cartes est obligatoire (validation Sanity).
import Bouton from '../Bouton.astro';
import Coches from '../Coches.astro';
import Emplacement from '../Emplacement.astro';
import LigneSource from '../LigneSource.astro';
import { typo } from '../../lib/typo';
import type { SectionTarifs } from '../../lib/types';

interface Props {
  section: SectionTarifs;
  niveau: 1 | 2;
}
const { section: s } = Astro.props;
---

<section class="conteneur" id={s.ancre} aria-label="Formules">
  <div class="formules">
    {
      s.formules.map((f) => (
        <div class:list={['formule', { 'formule--avant': f.miseEnAvant }]} data-theme={f.miseEnAvant ? 'produit' : undefined}>
          <h3 class="titre-carte">{typo(f.nom)}</h3>
          <div class="clients">
            <span class="libelle-clients">Chiffre d'affaires</span>
            <div class:list={['valeur-clients', { 'valeur-clients--emplacement': !f.chiffreAffaires.valeur }]}>
              {typo(f.chiffreAffaires.valeur || f.chiffreAffaires.emplacement)}
            </div>
          </div>
          <p class="texte-secondaire">{typo(f.description)}</p>
          {f.prix.valeur ? (
            <p class="prix">
              <span class="montant chiffres">{typo(f.prix.valeur)}</span>
              {f.precisionPrix && <span class="periode">{typo(f.precisionPrix)}</span>}
            </p>
          ) : (
            <Emplacement libelle={f.prix.emplacement ?? 'prix'} taille="prix" />
          )}
          <Coches elements={f.coches} class="coches-formule" />
          <Bouton lien={f.bouton} pleineLargeur />
        </div>
      ))
    }
  </div>
  {s.source?.length ? <LigneSource blocs={s.source} class="source-tarifs" /> : null}
</section>

<style>
  .formules {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-300);
  }

  .formule {
    display: flex;
    flex-direction: column;
    gap: var(--space-250);
    padding: var(--space-400);
    border-radius: var(--radius-xl);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    color: var(--color-text-primary);
  }

  .formule--avant {
    background: var(--neutral-900);
    border-color: var(--neutral-900);
  }

  .clients {
    display: flex;
    flex-direction: column;
    gap: var(--space-100);
  }

  .libelle-clients {
    font-size: var(--text-xs-size);
    line-height: var(--text-xs-line);
    font-weight: 600;
    letter-spacing: var(--tracking-capitales);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .valeur-clients {
    display: flex;
    align-items: center;
    min-height: 72px;
    font-family: var(--title-sm-family);
    font-size: var(--title-sm-size);
    line-height: var(--title-sm-line);
    font-weight: 500;
  }

  .valeur-clients--emplacement {
    padding: var(--space-150) var(--space-200);
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-border-strong);
  }

  .prix {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-100);
  }

  .montant {
    font-size: var(--figure-lg-size);
    line-height: var(--figure-lg-line);
    font-weight: var(--figure-lg-weight);
    letter-spacing: var(--figure-lg-tracking);
  }

  .periode {
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-line);
    color: var(--color-text-secondary);
  }

  .conteneur :global(.source-tarifs) {
    margin-top: var(--space-300);
  }

  .formule :global(.coches-formule) {
    flex-grow: 1;
  }

  @media (max-width: 1023px) {
    .formules {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-200);
    }
  }

  @media (max-width: 767px) {
    .formule {
      padding: var(--space-300);
    }
  }
</style>
